{
  "name": "idressia-backend-ts",
  "version": "1.0.0",
  "description": "Idressia Backend API - TypeScript Express REST",
  "author": "Idressia",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prod": "node dist/index.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "docs": "apidoc -i src -o docs",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo"
  },
  "keywords": [
    "express",
    "typescript",
    "node.js",
    "sequelize",
    "mysql",
    "REST",
    "API"
  ],
  "dependencies": {
    "aws-sdk": "^2.1693.0",
    "axios": "^0.21.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "bluebird": "^3.5.0",
    "body-parser": "^1.17.0",
    "compression": "^1.6.2",
    "cors": "^2.8.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.15.2",
    "express-validation": "^1.0.2",
    "helmet": "^4.6.0",
    "http-status": "^1.0.1",
    "joi": "^10.4.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.4",
    "method-override": "^3.0.0",
    "moment-timezone": "^0.5.13",
    "morgan": "^1.8.1",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.3.1",
    "passport": "^0.4.0",
    "passport-http-bearer": "^1.0.1",
    "passport-jwt": "4.0.0",
    "pug": "^3.0.1",
    "sequelize": "^6.37.5",
    "ua-parser-js": "^2.0.9",
    "uuid": "^3.1.0",
    "winston": "^3.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bluebird": "^3.5.40",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.5",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
